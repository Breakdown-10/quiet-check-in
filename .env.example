# ==============================================================================
# Quiet Check-In - Environment Configuration
# ==============================================================================
# All variables below have sensible defaults for local development and demo testing.
# For local evaluation or Devpost video recording, NO configuration is required.
# ==============================================================================

# Ring Developer API & Webhook Verification
# In production, obtain this from the Ring Developer Console -> Webhooks -> Signing Secret
RING_HMAC_KEY=staging_ring_hmac_secret_key_demo_2026

# Ring Partner OAuth (Required only when linking live Ring accounts via OAuth 2.0 PKCE)
# RING_CLIENT_ID=your_ring_app_client_id
# RING_CLIENT_SECRET=your_ring_app_client_secret
# RING_OAUTH_REDIRECT_URI=https://your-domain.com/api/v1/auth/ring/callback

# Amazon Web Services (AWS) Credentials
# Required for live Bedrock AI, DynamoDB persistence, and SES email dispatch.
# (When running locally without AWS keys, deterministic template fallbacks are used automatically)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_optional_session_token
# SES_SENDER_EMAIL=your_verified_ses_email@example.com

# Amazon Bedrock Model Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Application Defaults
DEMO_CIRCLE_ID=circle_frank_phoenix
DEFAULT_TIMEZONE_OFFSET=-7.0
